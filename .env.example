# SafeAgents Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI-compatible API, e.g. Gemini (langgraph only)
# If LLM_API_KEY is set, it is used instead of the Azure settings below.
LLM_API_KEY=""
LLM_MODEL=""  # pin one exact model name
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"  # leave empty for OpenAI
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=6

# Azure OpenAI Configuration (Required if LLM_API_KEY is not set)
AZURE_DEPLOYMENT="your_deployment_name"
AZURE_API_VERSION="version"
AZURE_MODEL_NAME="your_model_name"
AZURE_SCOPE="azure_scope"
AZURE_TEMPERATURE=0

# Logging Configuration (Optional)
LOG_LEVEL=INFO
